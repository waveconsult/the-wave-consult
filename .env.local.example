# The Wave Consult — environment (briefing §8)
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Security boundary: the service-role key is SERVER-ONLY. Never expose it to the
# browser, never hard-code keys in source, never paste real keys into a chat.

# From Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — used in admin route handlers / Storage uploads
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used for metadata AND Stripe redirect targets.
# Set to the deployed app origin.
NEXT_PUBLIC_SITE_URL=https://app.wavehubtennis.com

# ── Payments (Stripe) ─────────────────────────────────────────
# From the Stripe dashboard (Developers → API keys, and Products).
# Create two one-time yearly Prices (Core €479, Private €779) and paste
# their price ids. STRIPE_WEBHOOK_SECRET comes from the webhook you add
# pointing at /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CORE=
STRIPE_PRICE_PRIVATE=

# ── Transactional email (Resend) ──────────────────────────────
RESEND_API_KEY=
# Verified sender address. Use onboarding@resend.dev until your own
# domain is verified in Resend.
RESEND_FROM=WaveHub <onboarding@resend.dev>

# ── Auto-accept cron ──────────────────────────────────────────
# Shared secret so only your scheduler can trigger the auto-accept endpoint
# (/api/cron/process-applications). Generate a long random string. The
# scheduler calls it with `?token=<secret>` or `Authorization: Bearer <secret>`.
CRON_SECRET=

# Storage: set to "true" if the `bet-shots` bucket is PUBLIC read.
# Leave "false" (default) to serve bet-slip screenshots via signed URLs.
NEXT_PUBLIC_BET_SHOTS_PUBLIC=false
