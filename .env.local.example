# The Wave Consult — environment (briefing §8)
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Security boundary: the service-role key is SERVER-ONLY. Never expose it to the
# browser, never hard-code keys in source, never paste real keys into a chat.

# From Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — used in admin route handlers / Storage uploads
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used for metadata AND Stripe redirect targets.
# Set to the deployed app origin.
NEXT_PUBLIC_SITE_URL=https://app.wavehubtennis.com

# ── Payments (Stripe) ─────────────────────────────────────────
# From the Stripe dashboard (Developers → API keys, and Products).
# Create three RECURRING Prices matching lib/plans.ts and paste their price ids
# — the app runs subscriptions, not one-time charges.
# STRIPE_WEBHOOK_SECRET comes from the webhook you add pointing at
# /api/stripe/webhook (events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One recurring Stripe price per membership length. The recurring interval on
# each must match lib/plans.ts: 3 months / 6 months / 12 months.
STRIPE_PRICE_3M=
STRIPE_PRICE_6M=
STRIPE_PRICE_1Y=

# ── Payments (FastSpring — Merchant of Record) ────────────────
# Which processor is live in the app UI: "stripe" (default) or "fastspring".
# Flip to fastspring only once the FastSpring store is approved & configured.
NEXT_PUBLIC_PAYMENTS_PROVIDER=stripe
# Popup storefront id (Dashboard → Storefronts → your Popup storefront).
#   test: wavehubtennis.test.onfastspring.com/popup-checkout
#   live: wavehubtennis.onfastspring.com/popup-checkout
# A ".test." storefront also switches the webhook into test mode: events with
# live:false are honoured. Point this at the LIVE storefront and test events are
# ignored automatically — that is the single switch for going live.
NEXT_PUBLIC_FASTSPRING_STOREFRONT=wavehubtennis.test.onfastspring.com/popup-checkout
# FastSpring product paths, one per membership length (Products → Path).
# CHECK THE INTERVAL on each product in the dashboard: the 6-month product must
# bill every 6 months and the 1-year product every 12 — a product left on the
# default "every 3 months" will overcharge the member several times a year.
#   3m -> EUR 149, every 3 months
#   6m -> EUR 299, every 6 months
#   1y -> EUR 599, every 12 months
NEXT_PUBLIC_FASTSPRING_PRODUCT_3M=
NEXT_PUBLIC_FASTSPRING_PRODUCT_6M=
NEXT_PUBLIC_FASTSPRING_PRODUCT_1Y=
# HMAC SHA256 secret from the webhook you add pointing at /api/fastspring/webhook
# (events: order.completed, subscription.activated, subscription.charge.completed,
# subscription.updated, subscription.canceled, subscription.deactivated).
FASTSPRING_WEBHOOK_SECRET=
# API credentials (Dashboard → Integrations → API Credentials). Server-side only.
# Needed for the account management portal and to cancel a subscription when a
# member deletes their account.
FASTSPRING_API_USERNAME=
FASTSPRING_API_PASSWORD=

# Storage: set to "true" if the `bet-shots` bucket is PUBLIC read.
# Leave "false" (default) to serve bet-slip screenshots via signed URLs.
NEXT_PUBLIC_BET_SHOTS_PUBLIC=false
